PORT=5000



ORS_API_KEY=
# ============================================================
# OPENROUTESERVICE
# ============================================================

ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=driving-car

GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1


# ============================================================
# OPENAQ - PRIMARY LIVE AIR QUALITY
# ============================================================

OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=


# Request protection
OPENAQ_MIN_REQUEST_INTERVAL_MS=350
OPENAQ_MAX_RETRIES=2
OPENAQ_REQUEST_CACHE_TTL_MS=60000
OPENAQ_RADIUS_KM=25

# ============================================================
# WAQI - SECONDARY LIVE AIR QUALITY
# ============================================================

WAQI_BASE_URL=https://api.waqi.info
WAQI_API_TOKEN=


# ============================================================
# AIRROUTE AQI ENGINE
# ============================================================

AQI_ROUTE_SAMPLE_METERS=400

AQI_STATION_RADIUS_METERS=25000

AQI_MAX_STATION_AGE_MINUTES=180

AQI_LIVE_MAX_AGE_MINUTES=60

AQI_STATION_CACHE_REFRESH_MINUTES=10



# ============================================================
# SPATIAL INTERPOLATION
# ============================================================

AQI_INTERPOLATION_MAX_DISTANCE_METERS=25000

# Minimum number of nearby stations preferred
AQI_MIN_NEARBY_STATIONS=2

# Maximum stations used for interpolation
AQI_MAX_NEARBY_STATIONS=5


AQI_PROVIDER_GRID_SPACING_KM=3

# ============================================================
# NOMINATIM
# ============================================================

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

APP_NAME=AirRoute
APP_CONTACT=your-email@example.com


AQI_CRITICAL_HOTSPOT_AQI=300
AQI_CRITICAL_HOTSPOT_DURATION_MINUTES=5
AQI_CRITICAL_HOTSPOT_EXPOSURE_SHARE=0.50